{
  "schema": "spritespatial_visual_benchmark_config_v1",
  "description": "Hero visual regression benchmark across current SpriteSpatial reconstruction phases.",
  "reference_phase": "phase6b_surface_flow",
  "reference_metrics_path": "benchmarks/reference_visual_benchmark.json",
  "assets": [
    {
      "name": "hero",
      "asset": "assets/samples/hero/spriteasset_v1.json",
      "semantic_overrides": "assets/samples/hero/semantic_overrides",
      "profile": "profiles/prototype_32.json"
    }
  ],
  "metrics": [
    "front_iou",
    "side_iou",
    "back_iou",
    "worst_view_iou",
    "semantic_match_ratio",
    "source_colour_match_score",
    "voxel_face_readability_score",
    "side_profile_readability_score",
    "directional_readability_score",
    "oblique_surface_readability",
    "staircase_artifact_score",
    "surface_fragmentation_score",
    "internal_black_face_ratio",
    "non_manifold_edge_count",
    "degenerate_face_count"
  ],
  "regression_thresholds": {
    "max_front_iou_drop": 0.05,
    "max_side_iou_drop": 0.05,
    "max_worst_view_iou_drop": 0.05,
    "max_semantic_match_ratio_drop": 0.05,
    "max_surface_fragmentation_increase": 0.0,
    "max_staircase_artifact_increase": 0.10,
    "max_non_manifold_edge_increase": 0.0
  },
  "phases": [
    {
      "name": "baseline_smoothed",
      "retries": 2,
      "expected_output_folder": "outputs/bm_hero_baseline",
      "out": "outputs/bm_hero_baseline",
      "args": [
        "--asset",
        "{asset}",
        "--profile",
        "{profile}",
        "--semantic-overrides",
        "{semantic_overrides}",
        "--semantic-override-mode",
        "supplement",
        "--closed-body",
        "--mesh-backend",
        "surface_nets",
        "--surface-net-smoothing-alpha",
        "0.65",
        "--render-profile",
        "voxel_sprite",
        "--godot-preview",
        "--emit-render-diagnostics",
        "--emit-canonical-view-metrics",
        "--emit-visual-mapping",
        "--out",
        "{out}"
      ]
    },
    {
      "name": "phase5e_semantic_depth",
      "retries": 2,
      "expected_output_folder": "outputs/bm_hero_5e",
      "out": "outputs/bm_hero_5e",
      "args": [
        "--asset",
        "{asset}",
        "--profile",
        "{profile}",
        "--semantic-overrides",
        "{semantic_overrides}",
        "--semantic-override-mode",
        "supplement",
        "--semantic-depth-profiles",
        "--semantic-depth-profile",
        "humanoid_voxel",
        "--closed-body",
        "--mesh-backend",
        "surface_nets",
        "--surface-net-smoothing-alpha",
        "0.65",
        "--render-profile",
        "voxel_sprite",
        "--godot-preview",
        "--emit-render-diagnostics",
        "--emit-canonical-view-metrics",
        "--emit-visual-mapping",
        "--out",
        "{out}"
      ]
    },
    {
      "name": "phase5g_directional_morphology",
      "retries": 2,
      "expected_output_folder": "outputs/bm_hero_5g",
      "out": "outputs/bm_hero_5g",
      "args": [
        "--asset",
        "{asset}",
        "--profile",
        "{profile}",
        "--semantic-overrides",
        "{semantic_overrides}",
        "--semantic-override-mode",
        "supplement",
        "--semantic-depth-profiles",
        "--semantic-depth-profile",
        "humanoid_voxel",
        "--directional-morphology",
        "--morphology-profile",
        "fantasy_humanoid",
        "--closed-body",
        "--mesh-backend",
        "surface_nets",
        "--surface-net-smoothing-alpha",
        "0.65",
        "--render-profile",
        "voxel_sprite",
        "--godot-preview",
        "--emit-directional-debug",
        "--emit-render-diagnostics",
        "--emit-canonical-view-metrics",
        "--emit-visual-mapping",
        "--out",
        "{out}"
      ]
    },
    {
      "name": "phase6b_surface_flow",
      "retries": 2,
      "expected_output_folder": "outputs/bm_hero_6b",
      "out": "outputs/bm_hero_6b",
      "args": [
        "--asset",
        "{asset}",
        "--profile",
        "{profile}",
        "--semantic-overrides",
        "{semantic_overrides}",
        "--semantic-override-mode",
        "supplement",
        "--semantic-depth-profiles",
        "--semantic-depth-profile",
        "humanoid_voxel",
        "--directional-morphology",
        "--morphology-profile",
        "fantasy_humanoid",
        "--surface-flow",
        "--surface-flow-strength",
        "0.45",
        "--surface-flow-iterations",
        "2",
        "--closed-body",
        "--mesh-backend",
        "surface_nets",
        "--surface-net-smoothing-alpha",
        "0.65",
        "--render-profile",
        "voxel_sprite",
        "--godot-preview",
        "--emit-surface-flow-debug",
        "--emit-directional-debug",
        "--emit-render-diagnostics",
        "--emit-canonical-view-metrics",
        "--emit-visual-mapping",
        "--out",
        "{out}"
      ]
    }
  ]
}
