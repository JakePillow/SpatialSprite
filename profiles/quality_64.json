{
  "name": "quality_64",
  "description": "Higher-resolution deterministic target profile reserved for stricter future builds.",
  "pipeline": "link_depth_volume",
  "depth_slices": 24,
  "voxel_size": 0.025,
  "model_depth_units": 0.72,
  "semantic_mode": "validated_regions",
  "primitive_mode": "depth_volume",
  "outline_policy": "nearest_valid_body_colour",
  "target_face_budget": 9000,
  "capture_angles": [0, 30, 45, 60, 90, 120, 135, 150, 180],
  "validation_thresholds": {
    "max_black_side_face_percentage": 0.03,
    "max_hollow_gap_ratio": 0.12,
    "max_fallback_colour_count": 0,
    "require_nonzero_faces": true,
    "require_front_back_dimension_match": true
  },
  "use_zfield": true,
  "use_primitives": true,
  "max_depth_slices": 32,
  "primitive_smoothing": "semantic_constrained",
  "semantic_override_mode": "replace",
  "semantic_override_dir": "assets/samples/hero/semantic_overrides",
  "require_semantic_overrides": false,
  "smoothing_enabled": true,
  "smoothing_mode": "hybrid_lowpoly",
  "smoothing_iterations": 2,
  "bevel_strength": 0.25,
  "silhouette_preservation_weight": 1.0,
  "semantic_boundary_weight": 0.9,
  "outline_preservation_weight": 1.0,
  "max_silhouette_drift_px": 1,
  "allow_inferred_back": false,
  "require_authored_back_sprite": true,
  "require_authored_side_sprites": true,
  "source_coverage_warning_level": "fail"
}
