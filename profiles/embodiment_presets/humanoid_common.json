{
  "schema": "spritespatial_embodiment_preset_profile_v1",
  "profile_id": "humanoid_common",
  "display_name": "Humanoid Common",
  "description": "Conservative semantic embodiment edits for humanoid sprites.",
  "presets": [
    {
      "preset_id": "push_face_forward",
      "display_name": "Push Face Forward",
      "description": "Adds a small forward facial protrusion while keeping silhouette authority.",
      "target_parts": ["face"],
      "parameter_changes": {
        "face": {
          "enabled": true,
          "front_bias": 0.24,
          "back_bias": 0.0,
          "thickness_scale": 1.08,
          "taper_strength": 0.10
        }
      },
      "safe_ranges": {
        "front_bias": [0.0, 0.35],
        "thickness_scale": [1.0, 1.15],
        "taper_strength": [0.0, 0.2]
      },
      "expected_effect": "Face/nose area reads less flat from oblique views.",
      "risk_notes": "Too much front bias can harm authored front readability."
    },
    {
      "preset_id": "thicken_torso",
      "display_name": "Thicken Torso",
      "description": "Makes the torso slightly fuller in depth.",
      "target_parts": ["torso"],
      "parameter_changes": {
        "torso": {
          "enabled": true,
          "thickness_scale": 1.18,
          "topology_preservation_weight": 1.2
        }
      },
      "safe_ranges": {
        "thickness_scale": [1.0, 1.25],
        "topology_preservation_weight": [1.0, 1.35]
      },
      "expected_effect": "Torso becomes less papery while preserving front silhouette.",
      "risk_notes": "Can slightly increase local non-manifold cleanup load."
    },
    {
      "preset_id": "slim_torso",
      "display_name": "Slim Torso",
      "description": "Reduces torso depth for sprites that look over-inflated.",
      "target_parts": ["torso"],
      "parameter_changes": {
        "torso": {
          "enabled": true,
          "thickness_scale": 0.88,
          "side_width_scale": 0.96
        }
      },
      "safe_ranges": {
        "thickness_scale": [0.75, 1.0],
        "side_width_scale": [0.85, 1.0]
      },
      "expected_effect": "Torso side profile becomes slimmer.",
      "risk_notes": "Overuse can make the body feel flat."
    },
    {
      "preset_id": "thicken_limbs",
      "display_name": "Thicken Limbs",
      "description": "Adds depth to arms and legs.",
      "target_parts": ["left_arm", "right_arm", "left_leg", "right_leg"],
      "parameter_changes": {
        "left_arm": {"enabled": true, "thickness_scale": 1.12},
        "right_arm": {"enabled": true, "thickness_scale": 1.12},
        "left_leg": {"enabled": true, "thickness_scale": 1.10},
        "right_leg": {"enabled": true, "thickness_scale": 1.10}
      },
      "safe_ranges": {
        "thickness_scale": [1.0, 1.2]
      },
      "expected_effect": "Limbs read more cylindrical.",
      "risk_notes": "May reduce narrow pixel-art limb definition."
    },
    {
      "preset_id": "taper_limbs",
      "display_name": "Taper Limbs",
      "description": "Increases limb taper for clearer stylised anatomy.",
      "target_parts": ["left_arm", "right_arm", "left_leg", "right_leg"],
      "parameter_changes": {
        "left_arm": {"enabled": true, "taper_strength": 0.22},
        "right_arm": {"enabled": true, "taper_strength": 0.22},
        "left_leg": {"enabled": true, "taper_strength": 0.26},
        "right_leg": {"enabled": true, "taper_strength": 0.26}
      },
      "safe_ranges": {
        "taper_strength": [0.0, 0.35]
      },
      "expected_effect": "Limbs become less tubular and more readable.",
      "risk_notes": "Too much taper can weaken hands/feet contact."
    },
    {
      "preset_id": "widen_side_profile",
      "display_name": "Widen Side Profile",
      "description": "Broadens key body parts in side projection.",
      "target_parts": ["torso", "left_arm", "right_arm"],
      "parameter_changes": {
        "torso": {"enabled": true, "side_width_scale": 1.12, "thickness_scale": 1.08},
        "left_arm": {"enabled": true, "side_width_scale": 1.10},
        "right_arm": {"enabled": true, "side_width_scale": 1.10}
      },
      "safe_ranges": {
        "side_width_scale": [1.0, 1.2],
        "thickness_scale": [1.0, 1.15]
      },
      "expected_effect": "Side view looks less narrow.",
      "risk_notes": "Can conflict with strict side silhouettes."
    },
    {
      "preset_id": "soften_side_profile",
      "display_name": "Soften Side Profile",
      "description": "Reduces aggressive side width for cleaner silhouette.",
      "target_parts": ["torso", "left_arm", "right_arm"],
      "parameter_changes": {
        "torso": {"enabled": true, "side_width_scale": 0.96},
        "left_arm": {"enabled": true, "side_width_scale": 0.94},
        "right_arm": {"enabled": true, "side_width_scale": 0.94}
      },
      "safe_ranges": {
        "side_width_scale": [0.85, 1.0]
      },
      "expected_effect": "Side profile becomes less bulky.",
      "risk_notes": "Can reintroduce a flatter look."
    },
    {
      "preset_id": "broaden_shoulders",
      "display_name": "Broaden Shoulders",
      "description": "Adds mild side emphasis to upper limbs and torso.",
      "target_parts": ["torso", "left_arm", "right_arm"],
      "parameter_changes": {
        "torso": {"enabled": true, "side_width_scale": 1.06},
        "left_arm": {"enabled": true, "side_width_scale": 1.12},
        "right_arm": {"enabled": true, "side_width_scale": 1.12}
      },
      "safe_ranges": {
        "side_width_scale": [1.0, 1.2]
      },
      "expected_effect": "Upper body reads stronger in rotation.",
      "risk_notes": "Can overstate arms on tiny sprites."
    }
  ]
}
