{
  "name": "prototype_32",
  "description": "Default deterministic depth-volume baseline for current SpriteSpatial builds.",
  "pipeline": "link_depth_volume",
  "depth_slices": 12,
  "voxel_size": 0.05,
  "model_depth_units": 0.6,
  "semantic_mode": "none",
  "primitive_mode": "depth_volume",
  "outline_policy": "nearest_valid_body_colour",
  "target_face_budget": 4000,
  "capture_angles": [0, 45, 90, 135, 180],
  "validation_thresholds": {
    "max_black_side_face_percentage": 0.05,
    "max_hollow_gap_ratio": 0.2,
    "max_fallback_colour_count": 0,
    "require_nonzero_faces": true,
    "require_front_back_dimension_match": true
  },
  "use_zfield": true,
  "use_primitives": true,
  "zfield_resolution": "native",
  "max_depth_slices": 18,
  "semantic_override_mode": "supplement",
  "semantic_override_dir": "assets/samples/hero/semantic_overrides",
  "require_semantic_overrides": false,
  "smoothing_enabled": true,
  "smoothing_mode": "hybrid_lowpoly",
  "smoothing_iterations": 1,
  "bevel_strength": 0.15,
  "silhouette_preservation_weight": 1.0,
  "semantic_boundary_weight": 0.85,
  "outline_preservation_weight": 1.0,
  "max_silhouette_drift_px": 1,
  "allow_inferred_back": true,
  "source_coverage_warning_level": "warn"
}
